# ==============================================================================
# SECURE ROLE-BASED AUTHENTICATION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual secrets.
# NEVER commit the actual .env file or real secrets to Git.

# Server Environment
NODE_ENV=development
PORT=5000

# Security Pepper for Argon2id (Must be at least 32 characters, kept strictly outside the database)
ARGON2_PEPPER=your-very-long-and-secure-pepper-secret-change-this-in-production

# AES-256-GCM Encryption Key (Must be exactly 32 bytes / 64 hex characters)
# Used to encrypt TOTP secrets at rest in Firestore
AES_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# JWT Secrets (At least 32 characters each)
JWT_ACCESS_SECRET=your-secure-jwt-access-token-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-secure-jwt-refresh-token-secret-at-least-32-chars
JWT_2FA_SECRET=your-secure-jwt-2fa-pending-token-secret-at-least-32-chars

# Token Expiry Durations
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_2FA_EXPIRES_IN=5m

# Firebase / Google Cloud Configuration
# Option A: Path to service account json file relative to backend root
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Direct Environment Variables (Useful in cloud deployment like Render/Railway/CloudRun)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: Google Cloud Storage Bucket for database backups
FIREBASE_STORAGE_BUCKET=

# Optional: Local Firestore Emulator (for testing without live Firebase project)
# FIRESTORE_EMULATOR_HOST=localhost:8080

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
